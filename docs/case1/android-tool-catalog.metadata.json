{
  "version": 2,
  "note": "审核用 Catalog 快照。usage 由 arguments 生成，不是独立事实来源；运行时事实来源为 android-tool-catalog.ts。",
  "tools": [
    {
      "batch": 1,
      "toolId": "contact",
      "cliName": "contact",
      "summary": "匹配联系人 -> candidates[]（不含号码）",
      "description": "按姓名/称呼匹配通讯录。lookup 只查号不拨号；call 按姓名进入拨打流程（唯一命中可直拨，多候选返回列表后需 select）。候选列表不含号码，不要先查后dial；用户提供明确号码用 dial",
      "usage": "contact <lookup|call> <name>",
      "arguments": [
        {
          "name": "sub",
          "description": "联系人操作：lookup 仅查询，call 进入拨打流程。",
          "format": "positional",
          "required": true,
          "type": "enum",
          "values": [
            "lookup",
            "call"
          ]
        },
        {
          "name": "query",
          "description": "联系人姓名或称呼。",
          "format": "positional",
          "required": true,
          "type": "text",
          "label": "name"
        }
      ],
      "examples": [
        "contact lookup 爸爸",
        "contact lookup 李行素",
        "contact call 张三",
        "contact call 李哲"
      ],
      "keywords": [
        "联系人",
        "查号",
        "通讯录",
        "打电话"
      ]
    },
    {
      "batch": 1,
      "toolId": "contact_add",
      "cliName": "contact.add",
      "summary": "存联系人",
      "description": "按 phone 查找联系人：存在则更新 name，否则新建。",
      "usage": "contact.add <phone> <name>",
      "arguments": [
        {
          "name": "phone",
          "description": "联系人电话号码。",
          "format": "positional",
          "required": true,
          "type": "text"
        },
        {
          "name": "name",
          "description": "联系人姓名；包含空格时使用双引号。",
          "format": "positional",
          "required": true,
          "type": "text"
        }
      ],
      "examples": [
        "contact.add 10086 中国移动"
      ],
      "keywords": [
        "保存联系人",
        "新建联系人"
      ]
    },
    {
      "batch": 1,
      "toolId": "contact_delete",
      "cliName": "contact.delete",
      "summary": "删联系人",
