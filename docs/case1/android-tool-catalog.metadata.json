    {
      "batch": 1,
      "toolId": "list_call_history",
      "cliName": "call.log",
      "summary": "通话记录 -> calls[]（含 number）",
      "description": "查询本机通话记录（未接 / 呼入 / 拨出）。省略类型参数时默认 all；省略 --time_scope 时默认 today；按时间倒序。",
      "usage": "call.log [<all|missed|incoming|outgoing>] [--time_scope <today|last_24h|last_7d>] [--limit <N>] [--groupby_ctype]",
      "arguments": [
        {
          "name": "type",
          "description": "通话类型，省略时默认 all。",
          "format": "positional",
          "required": false,
          "type": "enum",
          "values": [
            "all",
            "missed",
            "incoming",
            "outgoing"
          ]
        },
        {
          "name": "time_scope",
          "description": "查询时间范围，省略时默认 today。",
          "format": "flag",
          "required": false,
          "type": "enum",
          "values": [
            "today",
            "last_24h",
            "last_7d"
          ]
        },
        {
          "name": "limit",
          "description": "最多返回的记录数。",
          "format": "flag",
          "required": false,
          "type": "text",
          "label": "N"
        },
        {
          "name": "groupby_ctype",
          "description": "按通话类型分组返回。",
          "format": "switch",
          "required": false
        }
      ],
      "examples": [
        "call.log",
        "call.log missed",
        "call.log all --time_scope last_7d",
        "call.log missed --time_scope today --limit 50",
        "call.log all --time_scope last_7d --groupby_ctype"
      ],
      "keywords": [
        "未接",
        "通话记录",
        "漏接"
      ]
    },
