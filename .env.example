# Optional local overrides. The Workbench starts without this file or any API key.
# Recommended: add a Provider in Settings -> 模型 Provider. Saved credentials stay in .knot/.
# Copy to .env only if you want environment configuration; never commit .env.

# KNOT_CWD=/absolute/path/to/your/workspace
# KNOT_WORKBENCH_PORT=4317

# Optional DeepSeek environment profile (alternatively configure it in the UI).
# DEEPSEEK_API_KEY=YOUR_KEY
# KNOT_DEEPSEEK_MODEL=deepseek-flash

# Optional OpenAI-compatible environment profile; URL and model must be set together.
# KNOT_BASE_URL=https://your-provider.example/v1
# KNOT_MODEL=YOUR_MODEL
# KNOT_API_KEY=YOUR_KEY
